---
import '../styles/global.css';
import { icerik, c, type Dil } from '../lib/icerik';
import { t, anaYol, digerDil, bolumler, projeYolu, type Bolum } from '../lib/i18n';

interface Props {
  dil: Dil;
  baslik: string;
  aciklama: string;
  /** Bu sayfanın öteki dildeki adresi */
  karsiYol: string;
  sayfa: 'ana' | 'proje';
}
const { dil, baslik, aciklama, karsiYol, sayfa } = Astro.props;
const diger = digerDil(dil);
const site = icerik.site.adres;
const buAdres = new URL(Astro.url.pathname, site).href;
const karsiAdres = new URL(karsiYol, site).href;
const ogGorsel = new URL(`/og-${dil}.png`, site).href;
const ana = anaYol(dil);
const sira: Bolum[] = ['hakkimda', 'projeler', 'deneyim', 'egitim', 'yetenekler', 'iletisim'];
const bag = (b: Bolum) => `${sayfa === 'ana' ? '' : ana}#${bolumler[b][dil]}`;
const kisi = icerik.kisi;
---

<!doctype html>
<html lang={dil}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{baslik}</title>
    <meta name="description" content={aciklama} />
    <meta name="author" content={kisi.ad} />
    <link rel="canonical" href={buAdres} />
    <link rel="alternate" hreflang={dil} href={buAdres} />
    <link rel="alternate" hreflang={diger} href={karsiAdres} />
    <link rel="alternate" hreflang="x-default" href={dil === 'tr' ? buAdres : karsiAdres} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={kisi.ad} />
    <meta property="og:title" content={baslik} />
    <meta property="og:description" content={aciklama} />
    <meta property="og:url" content={buAdres} />
    <meta property="og:image" content={ogGorsel} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={dil === 'tr' ? 'tr_TR' : 'en_GB'} />
    <meta property="og:locale:alternate" content={dil === 'tr' ? 'en_GB' : 'tr_TR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0b0e11" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f6f1" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/inter-tight-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var s = localStorage.getItem('tema');
          if (s === 'light' || s === 'dark') d.dataset.theme = s;
        } catch (e) {}
        // Hareket yalnızca tarayıcı destekliyorsa ve kullanıcı "hareketi azalt" demediyse açılır.
        // Betik bir nedenle çalışmazsa içerik gizli kalmasın diye sınıf geri alınır.
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
          d.classList.add('anim');
          setTimeout(function () {
            if (!window.__hazir) d.classList.remove('anim');
          }, 2500);
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body data-sayfa={sayfa} data-dil={dil}>
    <a class="atla" href="#icerik">{t('icerigeGec', dil)}</a>
    <div class="ilerleme" aria-hidden="true"><span></span></div>

    <header class="ust">
      <div class="ust-ic kap">
        <a class="imza" href={sayfa === 'ana' ? '#ust' : ana}>
          <span class="imza-kutu" aria-hidden="true">AY</span>
          <span class="imza-ad">{kisi.ad}</span>
        </a>

        <nav class="menu" aria-label={t('anaMenu', dil)}>
          <ul>
            {sira.map((b) => (
              <li><a href={bag(b)} data-bolum={bolumler[b][dil]}>{t(b, dil)}</a></li>
            ))}
          </ul>
        </nav>

        <div class="araclar">
          <button class="dugme-ikon js-only" type="button" data-palet-ac aria-label={t('ara', dil)} title={`${t('ara', dil)} (Ctrl K)`}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </button>
          <a class="dil" href={karsiYol} hreflang={diger} lang={diger} data-dil-degistir aria-label={`TR / EN: ${t('dilDegistir', dil)}`}>
            <span aria-hidden="true" class:list={[{ secili: dil === 'tr' }]}>TR</span><span aria-hidden="true" class="ayrac">/</span><span aria-hidden="true" class:list={[{ secili: dil === 'en' }]}>EN</span>
          </a>
          <button class="dugme-ikon js-only" type="button" data-tema aria-label={t('temaDegistir', dil)} title={t('temaDegistir', dil)}>
            <svg class="ay" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            <svg class="gunes" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </button>
          <details class="mobil-menu">
            <summary aria-label={t('menu', dil)}>
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </summary>
            <ul>
              {sira.map((b) => (
                <li><a href={bag(b)}>{t(b, dil)}</a></li>
              ))}
            </ul>
          </details>
        </div>
      </div>
    </header>

    <main id="icerik">
      <slot />
    </main>

    <footer class="alt">
      <div class="kap alt-ic">
        <p>© {new Date().getFullYear()} {kisi.ad}. {t('altBilgi', dil)}</p>
        <p><a href="https://github.com/AliYilmaz16/AliYilmaz16.github.io">{t('kaynak', dil)}</a></p>
      </div>
    </footer>

    <dialog class="palet" data-palet aria-label={t('paletBaslik', dil)}>
      <div class="palet-ust">
        <input type="text" role="combobox" aria-expanded="true" aria-controls="palet-liste" aria-autocomplete="list" autocomplete="off" spellcheck="false" placeholder={t('paletYer', dil)} aria-label={t('paletBaslik', dil)} />
        <button type="button" class="palet-kapat" data-palet-kapat aria-label={t('kapat', dil)}>Esc</button>
      </div>
      <ul id="palet-liste" role="listbox" aria-label={t('paletBaslik', dil)}>
        {sira.map((b) => (
          <li role="option" aria-selected="false"><a href={bag(b)} tabindex="-1"><span class="tur">{t('paletBolum', dil)}</span>{t(b, dil)}</a></li>
        ))}
        {icerik.projeler.map((p) => (
          <li role="option" aria-selected="false"><a href={projeYolu(dil, p.kimlik)} tabindex="-1" data-ara={p.araclar.join(' ')}><span class="tur">{t('paletProje', dil)}</span>{c(p.ad, dil)}</a></li>
        ))}
        <li role="option" aria-selected="false"><a href="#" tabindex="-1" data-komut="tema" data-ara="tema theme dark light koyu açık"><span class="tur">{t('paletKomut', dil)}</span>{t('temaDegistir', dil)}</a></li>
        <li role="option" aria-selected="false"><a href={karsiYol} tabindex="-1" data-komut="dil" data-ara="dil language english türkçe"><span class="tur">{t('paletKomut', dil)}</span>{t('dilDegistir', dil)}</a></li>
        <li role="option" aria-selected="false"><a href="#" tabindex="-1" data-komut="yazdir" data-ara="cv özgeçmiş print pdf yazdır"><span class="tur">{t('paletKomut', dil)}</span>{t('yazdir', dil)}</a></li>
      </ul>
      <p class="palet-bos" hidden>{t('paletBos', dil)}</p>
    </dialog>

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
