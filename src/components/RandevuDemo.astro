---
// Berber randevu sisteminin iki yüzü yan yana: müşteri randevu alır, berber panelden onaylar ya da reddeder.
// Bütün veriler örnektir, tarayıcıda kalır.
import type { Dil } from '../lib/icerik';
interface Props { dil: Dil }
const { dil } = Astro.props;
const T = (tr: string, en: string) => (dil === 'tr' ? tr : en);
const hizmetler = [
  { ad: T('Saç kesimi', 'Haircut'), sure: 30, ucret: 300 },
  { ad: T('Sakal tıraşı', 'Beard trim'), sure: 15, ucret: 150 },
  { ad: T('Saç + sakal', 'Hair + beard'), sure: 45, ucret: 400 },
  { ad: T('Çocuk kesimi', "Child's cut"), sure: 20, ucret: 250 },
];
---

<div
  class="demo demo-randevu js-only"
  data-demo-randevu
  data-hizmetler={JSON.stringify(hizmetler)}
  data-sen={T('Sen', 'You')}
  data-m-bas={T('Soldan bir saat seç. Randevun sağdaki berber paneline düşer.', "Pick a time on the left. Your booking lands in the barber's panel on the right.")}
  data-m-alindi={T('{s} için randevu isteği gönderildi. Berber onaylayana kadar bekliyor ama o saat artık başkasına verilmez.', 'Booking request sent for {s}. It waits for the barber to approve, but that time is no longer offered to anyone else.')}
  data-m-onay={T('Onaylandı: {a}, {s}. Kazanca eklendi.', 'Approved: {a}, {s}. Added to earnings.')}
  data-m-red={T('Reddedildi: {a}, {s}. Saat yeniden müsait.', 'Declined: {a}, {s}. The time is free again.')}
  data-m-musait={T('{m} müsait saat. Elenenler: {d} dolu, {o} mola, {k} kapanışı taşıyor.', '{m} free times. Ruled out: {d} taken, {o} break, {k} past closing.')}
  data-e-bekliyor={T('Onay bekliyor', 'Awaiting approval')}
  data-e-onayli={T('Onaylandı', 'Approved')}
  data-e-onayla={T('Onayla', 'Approve')}
  data-e-reddet={T('Reddet', 'Decline')}
  data-e-bugun={T('Bugün', 'Today')}
  data-e-bekleyen={T('Bekleyen', 'Pending')}
  data-e-kazanc={T('Kazanç', 'Earnings')}
  data-e-yok={T('Henüz randevun yok.', 'You have no booking yet.')}
>
  <div class="demo-satir">
    <p class="demo-etiket">{T('Günün takvimi (09.00 - 20.00, örnek veri)', "The day's calendar (09:00 - 20:00, sample data)")}</p>
    <div class="gun-seridi" data-serit aria-hidden="true"></div>
    <p class="demo-aciklama">
      <span class="ornek dolu"></span>{T('onaylı', 'approved')}
      <span class="ornek bekleyen"></span>{T('onay bekliyor', 'awaiting approval')}
      <span class="ornek mola"></span>{T('öğle arası', 'lunch break')}
    </p>
  </div>

  <div class="rd-iki">
    <section class="rd-pano" aria-label={T('Müşteri ekranı', 'Customer screen')}>
      <h4><span>{T('Müşteri', 'Customer')}</span>{T('telefondan randevu alır', 'books from the phone')}</h4>
      <div class="secenekler" role="group" aria-label={T('Hizmet', 'Service')}>
        {hizmetler.map((h, i) => (
          <button type="button" class="secenek" data-hizmet={i} aria-pressed={i === 0 ? 'true' : 'false'}>
            {h.ad} <span class="soluk">{h.sure} {T('dk', 'min')}</span>
          </button>
        ))}
      </div>
      <div class="saatler" data-saatler role="group" aria-label={T('Müsait saatler', 'Free times')}></div>
      <p class="rd-not" data-musait></p>
      <ul class="rd-benim" data-benim aria-label={T('Randevuların', 'Your bookings')}></ul>
    </section>

    <section class="rd-pano" aria-label={T('Berber paneli', "Barber's panel")}>
      <h4><span>{T('Berber', 'Barber')}</span>{T('panelden günü yönetir', 'runs the day from the panel')}</h4>
      <dl class="rd-ozet" data-ozet></dl>
      <ul class="rd-liste" data-liste aria-label={T('Günün randevuları', "Today's appointments")}></ul>
    </section>
  </div>

  <p class="demo-durum" data-durum role="status" aria-live="polite"></p>
  <p><button type="button" class="dugme" data-sifirla>{T('Baştan başla', 'Start over')}</button></p>
</div>

<script>
  import '../scripts/demo-randevu.ts';
</script>
