---
// Ana sayfadaki proje paneli: solda görsel ve özet, sağda etkileşimli örnek ya da kısa ayrıntılar.
import { Image, getImage } from 'astro:assets';
import { icerik, c, projeGorseli, type Dil, type Proje } from '../lib/icerik';
import { t, projeYolu } from '../lib/i18n';
import StackoutDemo from './StackoutDemo.astro';
import RandevuDemo from './RandevuDemo.astro';
import HammingDemo from './HammingDemo.astro';
import VurguDemo from './VurguDemo.astro';
import IsgDemo from './IsgDemo.astro';
import CalarDemo from './CalarDemo.astro';

interface Props { proje: Proje; dil: Dil; sira: number }
const { proje, dil, sira } = Astro.props;
const kapak = proje.gorseller[0];
const ad = c(proje.ad, dil);
const yol = projeYolu(dil, proje.kimlik);
const ayrintilar = (
  [
    ['sorun', c(proje.sorun, dil)],
    ['karar', c(proje.karar, dil)],
    ['sonuc', c(proje.sonuc, dil)],
  ] as const
).filter(([, m]) => m);
const afis = proje.video && kapak ? await getImage({ src: projeGorseli(proje.kimlik, kapak.dosya), format: 'webp', quality: 78, width: 960 }) : undefined;
---

<li class="kart" data-belir data-alan={proje.alan} id={`kart-${proje.kimlik}`}>
  <p class="kart-yil">{proje.yil}</p>
  <article>
    <div class="kart-sol">
      {proje.video && afis ? (
        <div class="kart-gorsel videolu" style={`view-transition-name: g-${proje.kimlik}`}>
          <video controls muted loop playsinline preload="none" poster={afis.src} width={afis.attributes.width} height={afis.attributes.height} aria-label={c(kapak.alt, dil)}>
            <source src={proje.video} type="video/mp4" />
          </video>
        </div>
      ) : kapak && (
        <div class="kart-gorsel" style={`view-transition-name: g-${proje.kimlik}`}>
          <Image
            src={projeGorseli(proje.kimlik, kapak.dosya)}
            alt=""
            widths={[420, 640, 960]}
            sizes="(min-width: 1180px) 480px, (min-width: 1101px) 40vw, 88vw"
            width={960}
            height={600}
            fit="cover"
            position="top"
            format="webp"
            quality={72}
            loading={sira < 1 ? 'eager' : 'lazy'}
          />
        </div>
      )}
      <div class="kart-govde">
        <p class="kart-ust">
          <span>{c(icerik.alanlar[proje.alan], dil)}</span>
          {c(proje.baglam, dil) && <span class="soluk">{c(proje.baglam, dil)}</span>}
        </p>
        <h3>
          <a href={yol} data-proje={proje.kimlik}>{ad}<span class="gizli"> — {t('ayrinti', dil)}</span></a>
        </h3>
      </div>
      <div class="kart-ozet">
        <p>{c(proje.ozet, dil)}</p>
        {proje.araclar.length > 0 && (
          <ul class="etiketler" aria-label={t('araclar', dil)}>
            {proje.araclar.slice(0, 8).map((a) => <li>{a}</li>)}
          </ul>
        )}
        <a class="kart-bag" href={yol} aria-hidden="true" tabindex="-1">{t('ayrinti', dil)} <span>→</span></a>
      </div>
    </div>

    <div class="kart-sag">
      {proje.etkilesim && (
        <div class="kart-dene js-only">
          <p class="kart-baslik">{t('dene', dil)}</p>
          {proje.etkilesim === 'stackout' && <StackoutDemo dil={dil} />}
          {proje.etkilesim === 'randevu' && <RandevuDemo dil={dil} />}
          {proje.etkilesim === 'hamming' && <HammingDemo dil={dil} />}
          {proje.etkilesim === 'vurgu' && <VurguDemo dil={dil} />}
          {proje.etkilesim === 'isg' && <IsgDemo dil={dil} />}
          {proje.etkilesim === 'calar' && <CalarDemo dil={dil} />}
        </div>
      )}
      {ayrintilar.length > 0 && (
        <dl class:list={['kart-detay', { 'js-yok': !!proje.etkilesim }]}>
          {ayrintilar.map(([anahtar, m]) => (
            <div>
              <dt>{t(anahtar, dil)}</dt>
              <dd>{m}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
    <span class="kose k1" aria-hidden="true"></span><span class="kose k2" aria-hidden="true"></span><span class="kose k3" aria-hidden="true"></span><span class="kose k4" aria-hidden="true"></span>
  </article>
</li>
