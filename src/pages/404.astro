---
import Base from '../layouts/Base.astro';
import { t } from '../lib/i18n';
---
<Base dil="tr" baslik="404 · Ali Yılmaz" aciklama={t('bulunamadi', 'tr')} karsiYol="/en/" sayfa="proje">
  <section class="kap bolum dort">
    <div>
      <p class="ustluk"><span class="nokta" aria-hidden="true"></span>404</p>
      <h1>Hedef bulunamadı</h1>
      <p class="tanitim">{t('bulunamadi', 'tr')} · {t('bulunamadi', 'en')}</p>
      <p class="dugmeler"><a class="dugme birincil" href="/">{t('anaSayfa', 'tr')}</a> <a class="dugme" href="/en/">{t('anaSayfa', 'en')}</a></p>
    </div>
    <div class="benzetim-alan dort-alan" aria-hidden="true">
      <span class="dort-nisan"><b>hedef yok · no target</b></span>
      <span class="dort-sayac">tespit 0 · detections 0</span>
      <span class="kose k1"></span><span class="kose k2"></span><span class="kose k3"></span><span class="kose k4"></span>
    </div>
  </section>
</Base>
